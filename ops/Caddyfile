{$SITE_HOST:localhost} {
    encode zstd gzip
    request_body {
        max_size 11MB
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    reverse_proxy frontend:3000 {
        header_up X-Synapse-Client-IP {remote_host}
        transport http {
            response_header_timeout 300s
        }
    }
}
